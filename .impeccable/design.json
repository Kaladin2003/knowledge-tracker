  "narrative": {
    "northStar": "The Personal Field Guide",
    "overview": "Knowledge Garden is drawn as a naturalist's field guide that the reader writes by learning. Topics are numbered sections, lessons are numbered entries (2.3 = section 2, entry 3), the garden is a captioned plate, and the topic list is an index. The cover is a deep bottle green; the pages are white plates resting on a pale grey-green ground, separated by hairline rules.\n\nThe system is calm and dense enough for a five-minute daily visit: one obvious next step, honest numbers, no confetti. Expression lives in the details a field guide would have: tabular entry numbers, condensed display lettering, plate captions, and topic colours carried by small tree pictograms. It rejects the cartoon learning-app look: no mascots, no bubbly gradients, no emoji used as icons.",
    "keyCharacteristics": [
      "Numbered everything: sections, entries, plates.",
      "White plates on a grey-green ground with hairline rules, not floating cards.",
      "Condensed display face for headings and numbers, a serif only for reading, system UI for controls.",
      "Colour is reserved in the interface (one green action colour, one rust streak colour); the garden is where colour lives, one tree species per category."
    ],
    "rules": [
      {
        "name": "The One Rust Rule",
        "body": "Rust means the streak. Never use it for buttons, links or decoration.",
        "section": "colors"
      },
      {
        "name": "The Species Rule",
        "body": "A category is shown by its tree species (in the garden, the index, the topic header and the key), never by a coloured label. Text and controls stay green and ink.",
        "section": "colors"
      },
      {
        "name": "The Inline Number Rule",
        "body": "An entry number sits on the same line as its title (`1.3 Brakes: rim vs disc`) or in a column beside it. It never sits above a heading as a kicker.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can change (entry numbers, counts, scores, streak) uses `font-variant-numeric: tabular-nums`.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** number sections and entries and show the number with the title.",
      "**Do** credit Wikipedia under every lesson with a link and the licence.",
      "**Do** keep every interactive element keyboard-reachable, garden trees included (`tabindex=\"0\"`, `role=\"button\"`, Enter/Space)."
    ],
    "donts": [
      "**Don't** use emoji as icons; add a path to `ICON_PATHS` instead.",
      "**Don't** put a small label above a heading (kicker/eyebrow).",
      "**Don't** use rust outside the streak, or tree colours on text and controls.",
      "**Don't** copy another app's garden artwork; draw new species in `trees.js` in the same flat-shaded style.",
      "**Don't** add a coloured stripe on the side of a card or a gradient on text."
    ]
  }
